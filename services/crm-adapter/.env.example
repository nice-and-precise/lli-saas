# --- Monday.com OAuth (required) ---
PORT=3000
MONDAY_CLIENT_ID=your-client-id
MONDAY_CLIENT_SECRET=your-client-secret
# Local dev callback; in production set to https://crm.jordandamhof.com/auth/callback
MONDAY_REDIRECT_URI=http://localhost:3000/auth/callback
MONDAY_API_BASE_URL=https://api.monday.com/v2

# --- State persistence ---
# "file" (default, local/dev/tests) or "kv" (Vercel — no persistent FS).
STATE_STORE_BACKEND=file
# Used when STATE_STORE_BACKEND=file:
CRM_ADAPTER_STATE_PATH=./data/monday-state.json
# Used when STATE_STORE_BACKEND=kv (Upstash via Vercel KV marketplace integration,
# which injects KV_REST_API_URL / KV_REST_API_TOKEN automatically):
CRM_ADAPTER_KV_KEY=crm-adapter:state
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Inter-service auth (production) ---
# When set, /owners and /leads require Authorization: Bearer <this value>.
# Leave blank in local dev/tests. Set equal to lead-engine's SERVICE_SHARED_SECRET.
SERVICE_SHARED_SECRET=

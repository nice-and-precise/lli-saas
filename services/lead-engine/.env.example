PORT=8000
# Local dev defaults; in production point at the deployed backend domains:
#   CRM_ADAPTER_BASE_URL=https://crm.jordandamhof.com
#   OBITUARY_ENGINE_BASE_URL=https://obit.jordandamhof.com
CRM_ADAPTER_BASE_URL=http://localhost:3000
OBITUARY_ENGINE_BASE_URL=http://localhost:8080

# --- Inter-service auth (production) ---
# When set, /run-scan requires Authorization: Bearer <this value>, and the
# value is sent on outbound calls to crm-adapter. Set Vercel's CRON_SECRET to
# the SAME value so the daily Vercel Cron call authenticates automatically.
# Leave blank in local dev/tests.
SERVICE_SHARED_SECRET=

PORT=8080
OBITUARY_ENGINE_RETENTION_DAYS=30
OBITUARY_HTTP_TIMEOUT_SECONDS=10

# --- State persistence ---
# "file" (default, local/dev/tests) or "kv" (Vercel — no persistent FS).
STATE_STORE_BACKEND=file
# Used when STATE_STORE_BACKEND=file:
OBITUARY_ENGINE_STATE_PATH=./data/state.json
# Used when STATE_STORE_BACKEND=kv (Upstash via Vercel KV marketplace integration,
# which injects KV_REST_API_URL / KV_REST_API_TOKEN automatically):
OBITUARY_ENGINE_KV_KEY=obituary-engine:state
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Heir extraction (Anthropic via Vercel AI Gateway) ---
# The pilot routes Anthropic through Vercel AI Gateway so LLM billing +
# observability stay on the Vercel account. The Anthropic SDK reads
# ANTHROPIC_BASE_URL automatically; ANTHROPIC_API_KEY holds the AI Gateway key.
HEIR_EXTRACTION_PRIMARY_PROVIDER=anthropic
HEIR_EXTRACTION_PRIMARY_MODEL=anthropic/claude-sonnet-4.5
HEIR_EXTRACTION_FALLBACK_PROVIDER=anthropic
HEIR_EXTRACTION_FALLBACK_MODEL=anthropic/claude-sonnet-4.5
HEIR_EXTRACTION_FINAL_PROVIDER=anthropic
HEIR_EXTRACTION_FINAL_MODEL=anthropic/claude-sonnet-4.5
ANTHROPIC_BASE_URL=https://ai-gateway.vercel.sh
ANTHROPIC_API_KEY=
# Gemini is optional/unused in the pilot; leave blank to skip those providers.
GEMINI_API_KEY=
GOOGLE_API_KEY=
